{
  "name": "CBRL-Website",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "node scripts/clear-data-cache.js && next build",
    "start": "next start -p 3200",
    "lint": "eslint src",
    "optimize-images": "node scripts/optimize-images.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "test": "npm run test:network && npm run test:errors && npm run test:uploads && npm run test:access && npm run test:scan",
    "test:network": "npx tsx scripts/test-admin-network.mts",
    "test:access": "npx tsx scripts/test-access-stage.mts",
    "test:errors": "npx tsx scripts/test-error-messages.mts",
    "test:uploads": "npx tsx scripts/test-upload-validation.mts",
    "test:api": "npx tsx scripts/test-api-responses.mts",
    "migrate:content": "npx tsx scripts/migrate-content-to-supabase.mts",
    "test:scan": "npx tsx scripts/test-scan-logic.mts"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/typography": "^0.5.10",
    "@tanstack/react-query": "^5.102.8",
    "autoprefixer": "^10.4.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.525.0",
    "next": "^16.3.8",
    "postcss": "^8.4.32",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^4.12.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20.10.5",
    "@types/raf": "^3.4.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/trusted-types": "^2.0.7",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.8",
    "typescript": "^5.3.3"
  }
