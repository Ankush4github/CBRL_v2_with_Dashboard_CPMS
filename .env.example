# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
#
# One file. The public site, the content dashboard at /admin and CPMS at /cpms
# are one Next application, so there is one environment. Until they were merged
# there were three files: a shared .env.shared loaded through shared-env.cjs,
# plus one .env.local per app — an arrangement that existed only because Next
# reads .env files from its own project root and there were two roots.

# --- Supabase ---------------------------------------------------------------
# One project backs both the content dashboard and CPMS.
#
# Only the PUBLISHABLE key, here or anywhere. Row-level security is what
# separates website editors from patient records, and a service-role key
# bypasses RLS entirely — never add one to the app's environment.
# (scripts/migrate-content-to-supabase.mts needs one exactly once, passed on the
# command line so it never lands in a file; see the README.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# --- Contact form (EmailJS) -------------------------------------------------
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# --- Content dashboard (/admin) ---------------------------------------------
# Sign-in is Google, through Supabase. There is no shared dashboard password
# any more: access is granted per-account by a row in public.site_editors, and
# being able to sign in with Google is not by itself enough to get in.

# Signs the activity cookie that enforces the idle timeout and the eight-hour
# absolute cap — neither of which Supabase provides. At least 16 characters of
# randomness; changing it signs everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=at-least-16-random-characters

# --- Dashboard networking ---------------------------------------------------
# How many reverse proxies sit in front of the app. The IP allowlist below reads
# the client address this many entries from the RIGHT of X-Forwarded-For, because
# everything to the left of the proxy's own entry is supplied by the caller and
# can say anything.
#
#   1  = behind one nginx/Apache (the default, and the IIT KGP deployment)
#   0  = Node exposed directly; X-Forwarded-For is ignored entirely
#
# Getting this wrong lets a caller spoof their way past the allowlist, or locks
# you out of it. Confirm it with
# GET /api/admin/whoami after signing in — the reported clientIp must be your
# real address even when you send a fake X-Forwarded-For header.
TRUSTED_PROXY_HOPS=1

# Optional. Restricts /admin and /api/admin to these addresses; the public site
# is unaffected. Comma-separated IPs and CIDR ranges, IPv4 and IPv6.
# Leave unset to allow any address and rely on sign-in alone.
#
# Check /api/admin/whoami FIRST so you do not lock yourself out.
# ADMIN_ALLOWED_IPS=10.111.0.0/16, 203.0.113.5

# Optional. Pins the origin that dashboard writes must come from. Leave unset to
# derive it from X-Forwarded-Proto / X-Forwarded-Host, which is right whenever
# the proxy sets those headers.
# ADMIN_ORIGIN=https://cbrl.iitkgp.ac.in

# --- CPMS back-end secrets — NOT read by this app ---------------------------
# Nothing in src/ references any of the values below. They are consumed by
# Supabase Edge Functions — prescription OCR, web push, reminder mail, and the
# cron guard — which run on Supabase, not on this server. The copies that
# actually take effect are the ones set with:
#
#   supabase secrets set KEY=value --project-ref <project-ref>
#
# They are listed here because they were previously kept in a Next .env file,
# which made them look like application configuration. They are not; setting
# them here changes nothing at runtime. Keep a local copy only if you need one
# for reference.
#
# APP_URL must be https and must include the /cpms sub-path — it is the
# deep-link base for reminder emails and push notifications, and those links
# open patient screens.
# APP_URL=https://cbrl.iitkgp.ac.in/cpms
# NEXT_PUBLIC_SUPABASE_PROJECT_ID=your-project-ref
# GEMINI_API_KEY=
# VAPID_SUBJECT=mailto:someone@example.org
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# CRON_SECRET=
# RESEND_API_KEY=
#
# Overrides the sender for attendance reminder email. Optional — the function
# already defaults to CPMS <cpms@mail.cbrliitkgp.online>. Whatever is used here,
# its domain must be verified in Resend or every send is refused.
# ATTENDANCE_EMAIL_FROM=CPMS <cpms@mail.cbrliitkgp.online>
